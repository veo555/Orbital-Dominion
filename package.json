{
  "name": "orbital-dominion",
  "version": "6.0.0",
  "private": true,
  "description": "Orbital Dominion v4 - single-file HTML5 real-time strategy game with a swarm-agent economy. Source tree, build, tests.",
  "scripts": {
    "build": "python3 build.py",
    "www": "python3 build.py store && rm -rf www && cp -r dist/store www",
    "test:sim": "node tests/sim/smoke.js",
    "test:e2e": "python3 tests/e2e/e2e_smoke.py",
    "test": "bash tests/run_all.sh",
    "eco": "node tests/sim/eco.js 1,2,3,4,5,6 300",
    "match": "node tests/sim/match2.js 21,22,23,24 18 normal",
    "timeline": "node tests/sim/timeline.js 7 10",
    "serve": "python3 -m http.server 8080 --directory dist/pwa",
    "icons": "python3 tools/make_icons.py",
    "test:touch": "python3 tests/e2e/e2e_touch.py",
    "test:platform": "python3 tests/e2e/e2e_platform.py",
    "test:pwa": "python3 tests/e2e/e2e_pwa.py"
  },
  "engines": {
    "node": ">=18"
  }
}
